{
  "name": "card-bleed-expander",
  "version": "1.1.0",
  "private": true,
  "description": "Desktop tool to expand playing card edges for print bleed and crop marks",
  "author": "Card Bleed Expander",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "ELECTRON_RUN_AS_NODE= vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "sharp:platforms": "npm install --force --no-save @img/sharp-darwin-arm64@0.34.5 @img/sharp-libvips-darwin-arm64@1.2.4 @img/sharp-darwin-x64@0.34.5 @img/sharp-libvips-darwin-x64@1.2.4 @img/sharp-win32-x64@0.34.5 @img/sharp-libvips-win32-x64@1.2.4",
    "pack": "npm run typecheck && npm run build && npm run sharp:platforms",
    "dist": "npm run pack && electron-builder --mac --win",
    "dist:mac": "npm run pack && electron-builder --mac",
    "dist:win": "npm run pack && electron-builder --win"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^36.3.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.cardbleed.expander",
    "productName": "Card Bleed Expander",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/sharp/**/*",
      "**/node_modules/@img/**/*"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        },
        {
          "target": "zip",
          "arch": ["arm64", "x64"]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
