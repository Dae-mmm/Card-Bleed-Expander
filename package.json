{
  "name": "card-bleed-expander",
  "version": "2.0.0",
  "private": true,
  "description": "Browser tool to expand playing card edges for print bleed and crop marks — files stay on your device",
  "author": "Card Bleed Expander",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "desktop:dev": "npx --yes @tauri-apps/cli@2 dev",
    "desktop:build": "npx --yes @tauri-apps/cli@2 build"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "nodemailer": "^10.0.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@vercel/node": "^13.0.1",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
