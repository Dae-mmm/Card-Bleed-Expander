{
  "name": "card-bleed-expander",
  "version": "2.0.0",
  "private": true,
  "description": "Browser tool to expand playing card edges for print bleed and crop marks — files stay on your device",
  "author": "Card Bleed Expander",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
